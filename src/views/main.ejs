<%- include("header") %>
    <%- include("navbar") %>
        <main class="container">
            <div class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-body-secondary main_jumbo">
                <div class="col-md-9 col-10 px-0">
                    <h1 class="display-4 fst-italic">Acreditado com excelência ONA!</h1>
                    <p class="lead my-3 z-3">O <strong>HOSPITAL E MATERNIDADE THEREZINHA DE JESUS (HTMJ)</strong> faz
                        parte
                        do Sistems Unico
                        de Saúde,
                        e é <strong>100% SUS</strong>. É uma instituição filantropica e não cobra nenhum valor de
                        pacientes ou
                        acompanhantes.</p>
                    </p>
                </div>
            </div>

            <section id="destaque">
                <div class="row mb-2">
                    <div class="col-md-6">
                        <div
                            class="row g-0 border rounded overflow-hidden flex-md-row mb-4 shadow-sm h-md-250 position-relative">
                            <div class="col p-4 d-flex flex-column position-static">
                                <h3 class="mb-0">Visitas e Atendimentos</h3>
                                <p class="card-text">Informações sobre horários, restrições e orientações para
                                    visitas, consultas eletivas e normas de segurança durante a internação no hospital.
                                </p>
                                <a href="/page/informacoes-aos-usuarios"
                                    class="icon-link gap-1 icon-link-hover custom-hover stretched-link text-decoration-none link-destaque">
                                    Continue lendo
                                </a>
                            </div>
                            <div class="col-auto d-none d-lg-block">
                                <img src="/img/visitas_atendimentos.png" class="img-fluid"
                                    alt="Médico segurando Estetoscopio" width="180px">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div
                            class="row g-0 border rounded overflow-hidden flex-md-row mb-4 shadow-sm h-md-250 position-relative">
                            <div class="col p-4 d-flex flex-column position-static">
                                <h3 class="mb-0">Maternidade</h3>
                                <p class="card-text">Logo que nasce, o recém-nascido precisa se manter quentinho e
                                    limpinho.
                                    você sabe o que precisa levar na mala do bebe para a maternidade?
                                </p>
                                <a href="/page/setores-e-servicos-de-saude-maternidade"
                                    class="icon-link gap-1 icon-link-hover custom-hover stretched-link text-decoration-none link-destaque">
                                    Continue lendo
                                </a>
                            </div>
                            <div class="col-auto d-none d-lg-block">
                                <img src="/img/maternidade.png" class="img-fluid"
                                    alt="Mulher grávida fazendo carinho na barriga" width="180px">
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section id="unidades_gerenciadas" class="my-5">
                <div class="row align-items-md-center g-3">
                    <div class="col d-flex flex-column align-items-start gap-2">
                        <h2 class="fw-bold text-body-emphasis">Unidades Gerenciadas</h2>
                        <p class="text-body-secondary">Conheça todas as unidades de saúde gerenciadas pela OSS HMTJ.</p>
                        <a href="/unidades" class="btn btn-destaque btn-lg w-50">Confira</a>
                    </div>

                    <% unidades.slice(0, 2).forEach(item=> { %>
                        <div class="col custom-card">
                            <a href="/unidade/<%= item.unidade %>" class="text-decoration-none hover-image">
                                <div class="card card-cover h-100 overflow-hidden text-bg-dark rounded-2 shadow-lg"
                                    style="background: linear-gradient(0deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('<%= item.img %>');background-size: 100% 100%;">
                                    <div class="d-flex flex-column h-100 p-5 pb-3 text-white">
                                        <h3 class="fw-bold">
                                            <%= item.nome %>
                                        </h3>
                                        <ul class="d-flex list-unstyled mt-auto">
                                            <li class="d-flex align-items-center me-3">
                                                <i class="bi bi-geo-alt-fill"></i>
                                                <small>
                                                    <%= item.cidade %>/<%= item.uf %>
                                                </small>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }) %>
                </div>

                <% for (let i=2; i < unidades.length; i +=3) { %>
                    <div class="row align-items-md-center g-3 py-3">
                        <% unidades.slice(i, i + 3).forEach(item=> { %>
                            <div class="col custom-card">
                                <a href="/unidade/<%= item.unidade %>" class="text-decoration-none hover-image">
                                    <div class="card card-cover h-100 overflow-hidden text-bg-dark rounded-2 shadow-lg"
                                        style="background: linear-gradient(0deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('<%= item.img %>');background-size: cover;">
                                        <div class="d-flex flex-column h-100 p-5 pb-3 text-white">
                                            <h3 class="fw-bold">
                                                <%= item.nome %>
                                            </h3>
                                            <ul class="d-flex list-unstyled mt-auto">
                                                <li class="d-flex align-items-center me-3">
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                    <small>
                                                        <%= item.cidade %>/<%= item.uf %>
                                                    </small>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
            </section>


            <section id="areas_destaque" class="my-5">
                <div class="row align-items-md-center g-3">
                    <div class="col d-flex flex-column align-items-start gap-2">
                        <h2 class="fw-bold text-body-emphasis">Áreas de destaque</h2>
                        <p class="text-body-secondary">Nossas áreas de atendimento em destaque</p>
                        <a href="/especialidades" class="btn btn-destaque btn-lg w-50">Confira</a>
                    </div>
                    <div class="col">
                        <ul class="list-group list-group-flush list-group-main">
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/ambulatorio-de-especialidades"><span>Ambulatório
                                        de Especialidades</span><i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/agencia-transfusional-hemoterapia"><span>Agência
                                        Transfusional/Hemoterapia</span><i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/cardiologia"><span>Cardiologia</span><i
                                        class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/central-de-material-esterilizado-cme"><span>Central
                                        de material Esterilizado - CME</span>
                                    <i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/centro-cirurgico"><span>Centro Cirúrgico</span><i
                                        class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    </div>
                    <div class="col">
                        <ul class="list-group list-group-flush list-group-main">
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/centro-de-parto-normal"><span>Centro de Parto
                                        Normal</span><i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/centro-de-referencia-em-alergia-e-urticarias"><span>Centro
                                        de Referencia em Alergia e Urticárias</span>
                                    <i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/centro-de-referencia-em-avc"><span>Centro de
                                        Referencia em AVC</span><i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/cirurgia-bariatrica"><span>Cirurgia
                                        Bariátrica</span><i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="list-group-item"><a
                                    class="icon-link icon-link-hover custom-hover text-decoration-none"
                                    href="/especialidade/clinica-de-odontologia"><span>Clínica de
                                        Odontologia</span><i class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </section>
        </main>
        <%- include("footer") %>