<%- include("header") %>
    <%- include("navbar") %>
        <main class="container">
            <div class="row mb-2">
                <div class="col p-4 d-flex flex-column position-static">
                    <h1 class="mb-3">Unidades Gerenciadas</h1>
                    <p class="mb-4">Conheça todas as unidades de saúde gerenciadas pela OSS HMTJ.</p>
                    <div class="mb-4 filtro-estado d-flex gap-2 flex-wrap">
                        <button class="btn btn-destaque activeBtn" data-estado="todos">TODOS</button>
                        <button class="btn btn-destaque" data-estado="mg">MG</button>
                        <button class="btn btn-destaque" data-estado="rj">RJ</button>
                        <button class="btn btn-destaque" data-estado="sp">SP</button>
                        <button class="btn btn-destaque" data-estado="go">GO</button>
                    </div>
                </div>
            </div>
            <div id="cards-container">
                <div class="row">
                    <div class="col-md-3 col-xs-6 my-2 unidades unidades_mg">
                        <div class="card">
                            <img src="https://hmtj.org.br/wp-content/uploads/2024/05/heapa-cf1-1.jpeg"
                                class="card-img-top img-fluid" alt="...">
                            <div class="card-body">
                                <h5 class="card-title">Card title</h5>
                                <p class="card-text">
                                    <i class="bi bi-geo-alt-fill"></i> Cidade/UF
                                </p>
                                <a href="/unidades/1" class="btn btn-destaque">Acessar portal</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-xs-6 my-2 unidades unidades_rj">
                        <div class="card">
                            <img src="https://hmtj.org.br/wp-content/uploads/2024/05/heapa-cf1-1.jpeg"
                                class="card-img-top img-fluid" alt="...">
                            <div class="card-body">
                                <h5 class="card-title">Card title</h5>
                                <p class="card-text">
                                    <i class="bi bi-geo-alt-fill"></i> Cidade/UF
                                </p>
                                <a href="/unidades/1" class="btn btn-destaque">Acessar portal</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-xs-6 my-2 unidades unidades_sp">
                        <div class="card">
                            <img src="https://hmtj.org.br/wp-content/uploads/2024/05/heapa-cf1-1.jpeg"
                                class="card-img-top img-fluid" alt="...">
                            <div class="card-body">
                                <h5 class="card-title">Card title</h5>
                                <p class="card-text">
                                    <i class="bi bi-geo-alt-fill"></i> Cidade/UF
                                </p>
                                <a href="/unidades/1" class="btn btn-destaque">Acessar portal</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-xs-6 my-2 unidades unidades_go">
                        <div class="card">
                            <img src="https://hmtj.org.br/wp-content/uploads/2024/05/heapa-cf1-1.jpeg"
                                class="card-img-top img-fluid" alt="...">
                            <div class="card-body">
                                <h5 class="card-title">Card title</h5>
                                <p class="card-text">
                                    <i class="bi bi-geo-alt-fill"></i> Cidade/UF
                                </p>
                                <a href="/unidades/1" class="btn btn-destaque">Acessar portal</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <%- include("footer") %>

            <script>
                const buttons = document.querySelectorAll(".filtro-estado button");
                const cards = document.querySelectorAll(".unidades");

                buttons.forEach(btn => {
                    btn.addEventListener("click", () => {
                        // Ativa botão
                        buttons.forEach(b => b.classList.remove("activeBtn"));
                        btn.classList.add("activeBtn");

                        const estado = btn.dataset.estado;

                        cards.forEach(card => {
                            if (estado === "todos") {
                                card.classList.remove("d-none");
                            } else {
                                if (card.classList.contains(`unidades_${estado}`)) {
                                    card.classList.remove("d-none");
                                } else {
                                    card.classList.add("d-none");
                                }
                            }
                        });
                    });
                });

            </script>