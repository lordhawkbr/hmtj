                    </ul>
                </div>
                <div class="col-12 col-lg-8 mb-4">
                    <ul class="nav nav-tabs nav-pills nav-fill justify-content-center" id="myTab" role="tablist">
                        <% transparencia.forEach(function(item, index) { %>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link custom-hover"
                                    id="<%= item.ano %>-tab" data-bs-toggle="tab" data-bs-target="#<%= item.ano %>">
                                    <%= item.ano %>
                                </button>
                            </li>
                            <% }) %>
                    </ul>
                    <div class="tab-content py-3">
                        <% transparencia.forEach(function(item, index) { %>
                            <div class="tab-pane" id="<%= item.ano %>" role="tabpanel"
                                aria-labelledby="<%= item.ano %>-tab" tabindex="0">
                                <h3>
                                    <%= item.ano %>
                                </h3>
                            </div>
                            <% }) %>
