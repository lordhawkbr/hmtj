<%- include("header") %>
    <%- include("navbar") %>
        <main class="container">
            <div class="row my-3">
                <div class="col-12">
                    <div class="jumbo_unidade">
                        <img src="<%= unidade.img %>" alt="" class="img-fluid rounded-4">
                    </div>
                </div>
                <div class="col-12">
                    <h1 class="my-3">
                        <%= unidade.nome %>
                    </h1>
                    <p class="my-3"><i class="bi bi-geo-alt-fill"></i>
                        <%= unidade.cidade %>/<%= unidade.uf %>
                    </p>
                    <p class="lead"><%- unidade.apresentacao %></p>
                </div>
            </div>
            <div class="row my-3 justify-content-center section-height">
                <div class="col-12 col-lg-4 text-md-center text-lg-start mb-4">
                    <h2 class="fw-bold text-body-emphasis">Transparência</h2>
                    <ul class="list-group list-group-flush list-group-unidades">
                    </ul>
                </div>
                <div class="col-12 col-lg-8 mb-4">
                    <ul class="nav nav-tabs nav-pills nav-fill justify-content-center" id="myTab" role="tablist">
                        <% transparencia.forEach(function(item, index) { %>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link custom-hover <%= index === transparencia.length - 1 ? 'active' : '' %>" id="<%= item.ano %>-tab" data-bs-toggle="tab"
                                    data-bs-target="#<%= item.ano %>">
                                    <%= item.ano %>
                                </button>
                            </li>
                            <% }) %>
                    </ul>
                    <div class="tab-content py-3">
                        <% transparencia.forEach(function(item) { const entries=Object.entries(item.publicacoes); const
                            metade=Math.ceil(entries.length / 2); const primeiraColuna=entries.slice(0, metade); const
                            segundaColuna=entries.slice(metade); %>
                            <div class="tab-pane" id="<%= item.ano %>" role="tabpanel"
                                aria-labelledby="<%= item.ano %>-tab" tabindex="0">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="accordion" id="accordion_esq_<%= item.ano %>">
                                            <% primeiraColuna.forEach(function([titulo, documentos], index) { %>
                                                <div class="accordion-item">
                                                    <p class="accordion-header">
                                                        <button class="accordion-button collapsed custom-hover"
                                                            type="button" data-bs-toggle="collapse"
                                                            data-bs-target="#clp<%= item.ano %>_esq<%= index %>"
                                                            aria-expanded="false"
                                                            aria-controls="clp<%= item.ano %>_esq<%= index %>">
                                                            <%= titulo %>
                                                        </button>
                                                    </p>
                                                    <div id="clp<%= item.ano %>_esq<%= index %>"
                                                        class="accordion-collapse collapse"
                                                        data-bs-parent="#accordion_esq_<%= item.ano %>">
                                                        <div class="accordion-body">
                                                            <% if (documentos.length> 0) { %>
                                                                <ul>
                                                                    <% documentos.forEach(function(doc) { %>
                                                                        <li>
                                                                            <%= doc %>
                                                                        </li>
                                                                        <% }) %>
                                                                </ul>
                                                                <% } else { %>
                                                                    <em>Sem documentos publicados.</em>
                                                                    <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="accordion" id="accordion_dir_<%= item.ano %>">
                                            <% segundaColuna.forEach(function([titulo, documentos], index) { %>
                                                <div class="accordion-item">
                                                    <p class="accordion-header">
                                                        <button class="accordion-button collapsed custom-hover"
                                                            type="button" data-bs-toggle="collapse"
                                                            data-bs-target="#clp<%= item.ano %>_dir<%= index %>"
                                                            aria-expanded="false"
                                                            aria-controls="clp<%= item.ano %>_dir<%= index %>">
                                                            <%= titulo %>
                                                        </button>
                                                    </p>
                                                    <div id="clp<%= item.ano %>_dir<%= index %>"
                                                        class="accordion-collapse collapse"
                                                        data-bs-parent="#accordion_dir_<%= item.ano %>">
                                                        <div class="accordion-body">
                                                            <% if (documentos.length> 0) { %>
                                                                <ul>
                                                                    <% documentos.forEach(function(doc) { %>
                                                                        <li>
                                                                            <%= doc %>
                                                                        </li>
                                                                        <% }) %>
                                                                </ul>
                                                                <% } else { %>
                                                                    <em>Sem documentos publicados.</em>
                                                                    <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
            </div>
            <div class="row my-3 justify-content-center section-height">
                <div class="col-12 col-lg-4 text-center text-lg-start mb-4">
                    <h2 class="fw-bold text-body-emphasis">Processos seletivos</h2>
                    <ul class="list-group list-group-flush list-group-unidades">
                        <li class="list-group-item">
                            <a class="d-flex align-items-center gap-2 text-decoration-none custom-hover" href="#">
                                <i class="bi bi-box-arrow-up-right"></i>
                                <span class="text-uppercase">INSCRIÇÃO</span>
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a class="d-flex align-items-center gap-2 text-decoration-none custom-hover" href="#">
                                <i class="bi bi-box-arrow-up-right"></i>
                                <span class="text-uppercase">PASSO A PASSO P/ INSCRIÇÃO (VIDEO)</span>
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a class="d-flex align-items-center gap-2 text-decoration-none custom-hover" href="#">
                                <i class="bi bi-box-arrow-up-right"></i>
                                <span class="text-uppercase">PEDIDO DE RECONSIDERAÇÃO</span>
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a class="d-flex align-items-center gap-2 text-decoration-none custom-hover" href="#">
                                <i class="bi bi-box-arrow-up-right"></i>
                                <span class="text-uppercase">DÚVIDAS</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4 mb-4">
                    <h5 class="section-title text-success">Em aberto</h5>
                    <ul class="list-group list-group-flush list-group-unidades">
                        <% editais.filter(e=> new Date(e.dtEncerramento.split("T")[0]) <= new Date()).forEach(e=> { %>
                                <li class="list-group-item">
                                    <a class="d-flex align-items-center gap-2 text-decoration-none custom-hover"
                                        href="/processo_seletivo/<%= e.id %>">
                                        <i class="bi bi-chevron-right text-primary icon-move"></i>
                                        <span>
                                            <%= e.subcategoria %>
                                        </span>
                                    </a>
                                </li>
                                <% }) %>
                    </ul>
                </div>
                <div class="col-6 col-lg-4 mb-4">
                    <h5 class="section-title text-danger">Encerrados</h5>
                    <ul class="list-group list-group-flush list-group-unidades">
                        <% editais.filter(e=> new Date(e.dtEncerramento.split("T")[0]) > new Date()).forEach(e => { %>
                            <li class="list-group-item">
                                <a class="d-flex align-items-center gap-2 text-decoration-none custom-hover"
                                    href="/processo_seletivo/<%= e.id %>">
                                    <i class="bi bi-chevron-right text-primary icon-move"></i>
                                    <span>
                                        <%= e.subcategoria %>
                                    </span>
                                </a>
                            </li>
                            <% }) %>
                    </ul>
                </div>
            </div>
        </main>
        <%- include("footer") %>